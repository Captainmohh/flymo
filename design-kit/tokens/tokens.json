{
  "$description": "AITA — Flight Ticket Assistant design tokens (W3C design-tokens style). Source: aita-frontend/app/globals.css",
  "color": {
    "brand": {
      "midnight":        { "$type": "color", "$value": "#011847", "oklch": "oklch(0.228 0.093 260.8)", "usage": "Page background, primary CTA" },
      "logo-navy":       { "$type": "color", "$value": "#00226C", "usage": "Logo mark ink" },
      "sky":             { "$type": "color", "$value": "#2352A5", "usage": "Illustration accent, highlights" },
      "ink":             { "$type": "color", "$value": "#263238", "usage": "Illustration outlines" },
      "cloud":           { "$type": "color", "$value": "#F5F5F5", "usage": "Illustration light fills" },
      "terracotta":      { "$type": "color", "$value": "#CE7A63", "usage": "Illustration warm accent" },
      "terracotta-deep": { "$type": "color", "$value": "#BA4D3C", "usage": "Illustration shadow accent" },
      "white":           { "$type": "color", "$value": "#FFFFFF", "usage": "Cards, header pill" }
    },
    "light": {
      "background":           { "$type": "color", "$value": "#011847" },
      "foreground":           { "$type": "color", "$value": "#FAFAFA" },
      "card":                 { "$type": "color", "$value": "#FFFFFF" },
      "card-foreground":      { "$type": "color", "$value": "#011847" },
      "popover":              { "$type": "color", "$value": "#FFFFFF" },
      "popover-foreground":   { "$type": "color", "$value": "#011847" },
      "primary":              { "$type": "color", "$value": "#011847" },
      "primary-foreground":   { "$type": "color", "$value": "#FAFAFA" },
      "secondary":            { "$type": "color", "$value": "#F5F5F5" },
      "secondary-foreground": { "$type": "color", "$value": "#171717" },
      "muted":                { "$type": "color", "$value": "#F5F5F5" },
      "muted-foreground":     { "$type": "color", "$value": "#737373" },
      "accent":               { "$type": "color", "$value": "#F5F5F5" },
      "accent-foreground":    { "$type": "color", "$value": "#171717" },
      "destructive":          { "$type": "color", "$value": "#E7000B" },
      "border":               { "$type": "color", "$value": "#E5E5E5" },
      "input":                { "$type": "color", "$value": "#E5E5E5" },
      "ring":                 { "$type": "color", "$value": "#A1A1A1" }
    },
    "dark": {
      "background":           { "$type": "color", "$value": "#0A0A0A" },
      "foreground":           { "$type": "color", "$value": "#FAFAFA" },
      "card":                 { "$type": "color", "$value": "#171717" },
      "card-foreground":      { "$type": "color", "$value": "#FAFAFA" },
      "primary":              { "$type": "color", "$value": "#E5E5E5" },
      "primary-foreground":   { "$type": "color", "$value": "#171717" },
      "secondary":            { "$type": "color", "$value": "#262626" },
      "muted":                { "$type": "color", "$value": "#262626" },
      "muted-foreground":     { "$type": "color", "$value": "#A1A1A1" },
      "destructive":          { "$type": "color", "$value": "#FF6467" },
      "border":               { "$type": "color", "$value": "rgba(255,255,255,0.10)" },
      "input":                { "$type": "color", "$value": "rgba(255,255,255,0.15)" },
      "sidebar-primary":      { "$type": "color", "$value": "#1447E6" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "#D4D4D4" },
      "2": { "$type": "color", "$value": "#737373" },
      "3": { "$type": "color", "$value": "#525252" },
      "4": { "$type": "color", "$value": "#404040" },
      "5": { "$type": "color", "$value": "#262626" }
    }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["Space Grotesk", "sans-serif"] },
      "sans":    { "$type": "fontFamily", "$value": ["Geist", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["Geist Mono", "monospace"] }
    },
    "scale": {
      "display": { "size": "3.75rem", "lineHeight": 1.25, "weight": 700, "family": "heading", "tailwind": "md:text-6xl font-bold leading-tight" },
      "h1-sm":   { "size": "2.25rem", "lineHeight": 1.25, "weight": 700, "family": "heading", "tailwind": "sm:text-4xl" },
      "h1-xs":   { "size": "1.875rem", "lineHeight": 1.25, "weight": 700, "family": "heading", "tailwind": "text-3xl" },
      "lead":    { "size": "1.125rem", "lineHeight": 1.55, "weight": 400, "family": "heading", "tailwind": "sm:text-lg text-foreground/70" },
      "nav":     { "size": "1rem",     "weight": 800, "family": "sans", "tailwind": "text-base font-extrabold" },
      "brand":   { "size": "1.125rem", "weight": 600, "family": "sans", "tailwind": "sm:text-lg font-semibold" },
      "button":  { "size": "0.875rem", "weight": 700, "family": "sans", "tailwind": "text-sm font-bold" },
      "caption": { "size": "0.75rem",  "weight": 400, "family": "sans", "tailwind": "text-xs text-muted-foreground" }
    }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "10px" },
    "xl":   { "$type": "dimension", "$value": "14px" },
    "2xl":  { "$type": "dimension", "$value": "18px" },
    "3xl":  { "$type": "dimension", "$value": "22px" },
    "4xl":  { "$type": "dimension", "$value": "26px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "size": {
    "button": { "xs": "24px", "sm": "28px", "default": "32px", "lg": "36px" },
    "container-max": "1024px",
    "sidebar": { "expanded": "256px", "collapsed": "64px" }
  }
}
